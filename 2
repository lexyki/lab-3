def celsius_to_fahrenheit(celsius):
    """Конвертує градуси Цельсія у Фаренгейт."""
    return celsius * 9 / 5 + 32


def fahrenheit_to_celsius(fahrenheit):
    """Конвертує градуси Фаренгейта у Цельсій."""
    return (fahrenheit - 32) * 5 / 9


def is_valid_temperature(value, scale):
    """Перевіряє, чи температура не нижча за абсолютний нуль."""
    if scale == "C":
        return value >= -273.15
    elif scale == "F":
        return value >= -459.67
    return False


# --- Основна програма ---
print("Конвертер температури")
print("1 — Цельсій -> Фаренгейт")
print("2 — Фаренгейт -> Цельсій")

choice = int(input("Оберіть напрямок (1-2): "))

if choice == 1:
    temp = float(input("Введіть температуру у °C: "))
    if not is_valid_temperature(temp, "C"):
        print("Помилка: температура нижча за абсолютний нуль!")
    else:
        result = celsius_to_fahrenheit(temp)
        print(f"{temp}°C = {result:.2f}°F")
elif choice == 2:
    temp = float(input("Введіть температуру у °F: "))
    if not is_valid_temperature(temp, "F"):
        print("Помилка: температура нижча за абсолютний нуль!")
    else:
        result = fahrenheit_to_celsius(temp)
        print(f"{temp}°F = {result:.2f}°C")
else:
    print("Помилка: невірний вибір!")
